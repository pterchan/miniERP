# Copy to a protected dotenv file before using --env-file, or let
# deploy_remote.sh generate a random remote .env when none is supplied.
POSTGRES_DB=inventory
POSTGRES_USER=inventory
POSTGRES_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-a-long-random-secret
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-password
BOOTSTRAP_REQUESTER_USERNAME=colleague
BOOTSTRAP_REQUESTER_PASSWORD=replace-with-a-long-password
OCR_INTERNAL_TOKEN=replace-with-a-long-random-token
OCR_PROXY_TIMEOUT_SECONDS=25
MINIO_ACCESS_KEY=change-me-minio-user
MINIO_SECRET_KEY=replace-with-a-long-minio-secret
MINIO_BUCKET=erp-product-images
WEB_PORT=127.0.0.1:18080
ERP_COOKIE_PATH=/erp
API_PORT=127.0.0.1:18001
POSTGRES_PORT=127.0.0.1:15432
CORS_ORIGINS=https://erp.example.com
