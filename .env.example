POSTGRES_PASSWORD=change-me
SESSION_SECRET=change-me-to-a-long-random-secret
# 每个 API worker 的连接池；最小值 0 表示不保留闲置连接
ERP_DB_POOL_MIN=1
ERP_DB_POOL_MAX=30
# 默认允许负库存；置 1 后校验出库、调拨与红冲的可用余额
ERP_FORBID_NEGATIVE_STOCK=0
# 管理员（最高权限）账号
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me
# 普通用户账号
BOOTSTRAP_REQUESTER_USERNAME=colleague
BOOTSTRAP_REQUESTER_PASSWORD=change-me
# 向后兼容变量（通常不需要设置）
# ERP_ADMIN_USERNAME=warehouse
# ERP_ADMIN_PASSWORD=change-me
OCR_INTERNAL_TOKEN=change-me-to-a-long-random-ocr-token
# OCR_PROXY_TIMEOUT_SECONDS=25
# 货品图片对象存储（MinIO，S3 兼容；ACCESS_KEY 3-20 字符，SECRET_KEY 8-40 字符）
MINIO_ACCESS_KEY=change-me-minio-user
MINIO_SECRET_KEY=change-me-to-a-long-minio-secret
MINIO_BUCKET=erp-product-images
# 可选：端口与允许的来源（多个来源以逗号分隔）
# WEB_PORT=127.0.0.1:18080
# ERP_COOKIE_PATH=/erp
# 会话/CSRF Cookie 的 Secure 标志：部署到 TLS 网关后置 1（compose 已透传）
# ERP_SECURE_COOKIES=0
# API_PORT=127.0.0.1:8000
# POSTGRES_PORT=127.0.0.1:5432
# CORS_ORIGINS=http://localhost
# MINIO_CONSOLE_PORT=127.0.0.1:19001
